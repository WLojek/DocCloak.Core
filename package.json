{
  "name": "@doccloak/core",
  "version": "0.10.0",
  "description": "Environment-agnostic document anonymization engine for the DocCloak ecosystem.",
  "license": "Apache-2.0",
  "author": "Witold Lojek",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./restore-tokens": "./src/restore-tokens.ts",
    "./dom": "./src/dom/index.ts",
    "./worker-protocol": "./src/worker-protocol.ts"
  },
  "files": [
    "dist",
    "rules",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "anonymization",
    "pii",
    "ner",
    "redaction",
    "privacy",
    "gdpr",
    "onnx",
    "docx",
    "ocr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WLojek/DocCloak.Core.git"
  },
  "homepage": "https://github.com/WLojek/DocCloak.Core#readme",
  "bugs": {
    "url": "https://github.com/WLojek/DocCloak.Core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs",
    "prepack": "npm run build && node scripts/package-exports.mjs dist",
    "postpack": "node scripts/package-exports.mjs src",
    "rules:gen": "node scripts/generate-rules-module.mjs",
    "rules:check": "node scripts/generate-rules-module.mjs --check",
    "bench": "node --experimental-strip-types eval/run.mts",
    "bench:multilang": "node --experimental-strip-types eval/multilang.mts",
    "bench:data": "node eval/download.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "typescript": "5.8.3",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "cfb": "1.2.2",
    "jszip": "3.10.1",
    "onnxruntime-web": "1.29.0",
    "tesseract.js": "7.0.0"
  }
}
