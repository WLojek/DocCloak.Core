  <office:body>
    <office:text>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Mietvertrag</text:h>
      <text:p text:style-name="Standard">Zwischen der Beispiel Hausverwaltung GmbH (Vermieter) und Hans-Jürgen Müller, wohnhaft Bergstraße 7, 10115 Berlin (Mieter), wird folgender Mietvertrag geschlossen.</text:p>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Miete</text:h>
      <text:p text:style-name="Standard">Die Miete ist monatlich auf das Konto DE89 3704 0044 0532 0130 00 zu überweisen.<text:note text:id="ftn3" text:note-class="footnote"><text:note-citation>3</text:note-citation><text:note-body><text:p text:style-name="Footnote">Kontoinhaber: Hans-Jürgen Müller, Telefon +49 30 1234 5678.</text:p></text:note-body></text:note></text:p>
      <table:table table:name="Parteien">
        <table:table-column table:number-columns-repeated="3"/>
        <table:table-header-rows>
        <table:table-row><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Rolle</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Name</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Kontakt</text:p></table:table-cell></table:table-row>
        </table:table-header-rows>
        <table:table-row><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Mieter</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Hans-Jürgen Müller</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">hj.mueller@beispiel-gmbh.de</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Vermieter</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">Friedrich Oberländer</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Table_20_Contents">DE44 5001 0517 5407 3249 31</text:p></table:table-cell></table:table-row>
      </table:table>
      <text:p text:style-name="Standard"><office:annotation office:name="__Annotation__2"><dc:creator>Annelore Schäfer</dc:creator><dc:date>2026-03-02T10:02:00</dc:date><text:p text:style-name="Standard">Bitte die Kontodaten von Friedrich Oberländer prüfen.</text:p></office:annotation>Der Mieter verpflichtet sich, die Wohnung pfleglich zu behandeln.</text:p>
      <text:p text:style-name="Standard">Änderungen dieses Vertrages bedürfen der Schriftform.</text:p>
    </office:text>
