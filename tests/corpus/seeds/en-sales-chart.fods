    <meta:creation-date>2026-03-02T09:00:00</meta:creation-date>
    <dc:date>2026-03-02T09:30:00</dc:date>
  </office:meta>
  <office:styles>
    <style:default-style style:family="table-cell">
      <style:text-properties fo:font-size="10pt"/>
    </style:default-style>
    <style:style style:name="Default" style:family="table-cell"/>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="co1" style:family="table-column">
      <style:table-column-properties style:column-width="4.5cm"/>
    </style:style>
    <style:style style:name="ta1" style:family="table" style:master-page-name="Default">
      <style:table-properties table:display="true" style:writing-mode="lr-tb"/>
    </style:style>
    <style:page-layout style:name="pm1">
      <style:page-layout-properties style:writing-mode="lr-tb"/>
      <style:header-style>
        <style:header-footer-properties fo:min-height="0.75cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-bottom="0.25cm"/>
      </style:header-style>
      <style:footer-style>
        <style:header-footer-properties fo:min-height="0.75cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:margin-top="0.25cm"/>
      </style:footer-style>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="pm1">
      <style:header>
        <text:p>Sales by rep, Q1 2026</text:p>
      </style:header>
      <style:footer>
        <text:p>Owner: priya.raghunathan@example-labs.io</text:p>
      </style:footer>
    </style:master-page>
  </office:master-styles>
  <office:body>
    <office:spreadsheet>
      <table:table table:name="Sales" table:style-name="ta1">
        <table:shapes>
          <draw:frame draw:z-index="0" draw:name="Chart 1" svg:width="12cm" svg:height="8cm" svg:x="10cm" svg:y="0.5cm">
            <draw:object>
          <office:document office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.chart">
            <office:automatic-styles>
              <style:style style:name="ch1" style:family="chart">
                <style:chart-properties/>
              </style:style>
              <style:style style:name="ch2" style:family="chart">
                <style:chart-properties chart:vertical="false"/>
              </style:style>
            </office:automatic-styles>
            <office:body>
              <office:chart>
                <chart:chart chart:class="chart:bar" svg:width="12cm" svg:height="8cm" chart:style-name="ch1">
                  <chart:title><text:p>Revenue per rep, region of Marcus Pemberton</text:p></chart:title>
                  <chart:legend chart:legend-position="end" style:legend-expansion="wide"/>
                  <chart:plot-area chart:style-name="ch2" table:cell-range-address="Sales.$A$1:.$B$4" chart:data-source-has-labels="both">
                    <chart:axis chart:dimension="x" chart:name="primary-x"><chart:categories table:cell-range-address="Sales.$A$2:.$A$4"/></chart:axis>
                    <chart:axis chart:dimension="y" chart:name="primary-y"/>
                    <chart:series chart:values-cell-range-address="Sales.$B$2:.$B$4" chart:label-cell-range-address="Sales.$B$1" chart:class="chart:bar">
                      <chart:data-point chart:repeated="3"/>
                    </chart:series>
                    <chart:wall/>
                    <chart:floor/>
                  </chart:plot-area>
                <table:table table:name="local-table">
                  <table:table-header-columns><table:table-column/></table:table-header-columns>
                  <table:table-columns><table:table-column/></table:table-columns>
                  <table:table-header-rows>
                    <table:table-row><table:table-cell><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>Revenue</text:p></table:table-cell></table:table-row>
                  </table:table-header-rows>
                  <table:table-rows>
                <table:table-row><table:table-cell office:value-type="string"><text:p>Eleanor Whitcombe</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="52000"><text:p>52000</text:p></table:table-cell></table:table-row>
                <table:table-row><table:table-cell office:value-type="string"><text:p>Priya Raghunathan</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="47000"><text:p>47000</text:p></table:table-cell></table:table-row>
                <table:table-row><table:table-cell office:value-type="string"><text:p>Desmond Okonkwo-Hart</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="61000"><text:p>61000</text:p></table:table-cell></table:table-row>
                  </table:table-rows>
                </table:table>
                </chart:chart>
              </office:chart>
            </office:body>
          </office:document>
        </draw:object>
          </draw:frame>
        </table:shapes>
        <table:table-column table:style-name="co1" table:number-columns-repeated="3" table:default-cell-style-name="Default"/>
        <table:table-row><table:table-cell office:value-type="string"><text:p>Rep</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Revenue</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Phone</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell office:value-type="string"><text:p>Eleanor Whitcombe</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="52000"><text:p>52000</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>+44 20 7946 0123</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell office:value-type="string"><text:p>Priya Raghunathan</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="47000"><text:p>47000</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p></text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell office:value-type="string"><text:p>Desmond Okonkwo-Hart</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="61000"><text:p>61000</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>+44 7700 900123</text:p></table:table-cell></table:table-row>
      </table:table>
      <table:table table:name="Notes Marcus Pemberton" table:style-name="ta1">
        <table:table-column table:style-name="co1" table:number-columns-repeated="1" table:default-cell-style-name="Default"/>
        <table:table-row><table:table-cell office:value-type="string"><text:p>Note</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell office:value-type="string"><office:annotation office:display="false"><dc:creator>Marcus Pemberton</dc:creator><dc:date>2026-03-02T11:00:00</dc:date><text:p>Ask Eleanor Whitcombe before escalating.</text:p></office:annotation><text:p>Escalations go to m.pemberton@harbourview-example.com</text:p></table:table-cell></table:table-row>
