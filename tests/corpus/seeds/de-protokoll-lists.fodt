    <office:text>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Protokoll der Gesellschafterversammlung</text:h>
      <text:p text:style-name="Standard">Anwesend:</text:p>
      <text:list text:style-name="Numbering_20_123">
        <text:list-item><text:p text:style-name="Standard">Hans-Jürgen Müller</text:p></text:list-item>
        <text:list-item><text:p text:style-name="Standard">Annelore Schäfer</text:p></text:list-item>
        <text:list-item><text:p text:style-name="Standard">Friedrich Oberländer</text:p></text:list-item>
      </text:list>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Beschlüsse</text:h>
      <text:section text:name="Beschluesse">
      <text:list text:style-name="Numbering_20_123">
        <text:list-item><text:p text:style-name="Standard">Die Geschäftsführung wird Friedrich Oberländer übertragen (IBAN DE44 5001 0517 5407 3249 31).</text:p></text:list-item>
        <text:list-item><text:p text:style-name="Standard">Der Sitz wird nach Lindenallee 22, 80331 München verlegt.</text:p></text:list-item>
        <text:list-item><text:p text:style-name="Standard">Hans-Jürgen Müller scheidet aus; Erreichbarkeit +49 30 1234 5678.</text:p></text:list-item>
      </text:list>
      </text:section>
      <text:p text:style-name="Standard">Protokoll geschlossen von Ingrid Vollmer-Brandt.</text:p>
