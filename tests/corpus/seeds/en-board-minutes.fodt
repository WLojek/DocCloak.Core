  <office:body>
    <office:text>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Minutes of the board meeting</text:h>
      <text:p text:style-name="Standard">Present: Marcus Pemberton, Eleanor Whitcombe, Desmond Okonkwo-Hart.</text:p>
      <text:h text:style-name="Heading_20_2" text:outline-level="2">Resolutions</text:h>
      <text:list text:style-name="List_20_Bullet">
        <text:list-item><text:p text:style-name="Standard"><office:annotation office:name="__Annotation__3"><dc:creator>Priya Raghunathan</dc:creator><dc:date>2026-03-02T10:03:00</dc:date><text:p text:style-name="Standard">Check with Marcus Pemberton whether the vote was unanimous.</text:p></office:annotation>The budget was approved.</text:p></text:list-item>
        <text:list-item><text:p text:style-name="Standard">Desmond Okonkwo-Hart (+44 7700 900123) will chair the audit committee.<text:note text:id="edn5" text:note-class="endnote"><text:note-citation>5</text:note-citation><text:note-body><text:p text:style-name="Footnote">Contact details confirmed by Desmond Okonkwo-Hart on 2 March 2026.</text:p></text:note-body></text:note></text:p></text:list-item>
        <text:list-item><text:p text:style-name="Standard">Next meeting hosted at 2210 Lakeshore Drive, Oakland, CA 94612.</text:p></text:list-item>
      </text:list>
      <text:p text:style-name="Standard"><office:annotation office:name="__Annotation__4"><dc:creator>Eleanor Whitcombe</dc:creator><dc:date>2026-03-02T10:04:00</dc:date><text:p text:style-name="Standard">Please send the draft to m.pemberton@harbourview-example.com.</text:p></office:annotation>Meeting closed at 16:30.</text:p>
    </office:text>
  </office:body>
