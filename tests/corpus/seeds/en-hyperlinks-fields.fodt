    <office:text>
      <text:h text:style-name="Heading_20_1" text:outline-level="1">Contacts</text:h>
      <text:p text:style-name="Standard"><text:bookmark text:name="contact_whitcombe"/>Primary contact: <text:a xlink:type="simple" xlink:href="mailto:eleanor.whitcombe@northgate-example.co.uk">Eleanor Whitcombe</text:a>.</text:p>
      <text:p text:style-name="Standard">Secondary contact: <text:a xlink:type="simple" xlink:href="mailto:m.pemberton@harbourview-example.com">m.pemberton@harbourview-example.com</text:a> (Marcus Pemberton).</text:p>
      <text:p text:style-name="Standard">Web: <text:a xlink:type="simple" xlink:href="https://example.com/team?owner=Priya%20Raghunathan">team page</text:a> maintained by Priya Raghunathan.</text:p>
      <text:p text:style-name="Standard">Today is <text:date text:date-value="2026-03-02">2026-03-02</text:date>; author <text:author-name text:fixed="true">Desmond Okonkwo-Hart</text:author-name>.</text:p>
    </office:text>
